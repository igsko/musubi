{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Musubi",
  "version": "0.1.0",
  "identifier": "com.leporia.musubi",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Musubi",
        "width": 360,
        "height": 640,
        "decorations": false,
        "minWidth": 200,
        "minHeight": 300
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://api.github.com https://objects.githubusercontent.com; img-src 'self' data:; style-src 'self' 'unsafe-inline';"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": []
  }
}
